new file mode 100644
index 0000000..60847fb
--- /dev/null
+++ b/lib/rate-limit.ts
@@ -0,0 +1,29 @@
+// In-memory sliding window, one per server process — same scope as lib/db.ts.
+// With several instances, move this to shared storage (Redis, the database).
+
+const MAX_KEYS = 10_000;
+
+const globalForLimits = globalThis as unknown as { leadDeskRateLimits?: Map<string, number[]> };
+const hits = (globalForLimits.leadDeskRateLimits ??= new Map<string, number[]>());
+
+/** Records a hit for `key`; returns false when the limit for the window is already used up. */
+export function takeRateLimit(key: string, limit: number, windowMs: number) {
+  const now = Date.now();
+  const recent = (hits.get(key) ?? []).filter((at) => now - at < windowMs);
+
+  if (recent.length >= limit) {
+    hits.set(key, recent);
+    return false;
+  }
+
+  recent.push(now);
+  hits.set(key, recent);
+
+  if (hits.size > MAX_KEYS) {
+    for (const [otherKey, times] of hits) {
+      if (times.every((at) => now - at >= windowMs)) hits.delete(otherKey);
+    }
+  }
+
+  return true;
+}

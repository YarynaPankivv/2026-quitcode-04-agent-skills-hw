 };
+
+export const QUOTE_BUDGETS = ["under-1000", "1000-3000", "3000-10000", "over-10000"] as const;
+
+export type QuoteBudget = (typeof QUOTE_BUDGETS)[number];
+
+// queued: saved, n8n has not confirmed the trigger yet; processing: n8n accepted it;
+// ready / failed: final, set once by the n8n callback (or by a failed trigger).
+export const QUOTE_STATUSES = ["queued", "processing", "ready", "failed"] as const;
+
+export type QuoteStatus = (typeof QUOTE_STATUSES)[number];
+
+export type QuoteRequest = {
+  id: string;
+  workspaceId: string;
+  company: string;
+  email: string;
+  description: string;
+  budget: QuoteBudget | null;
+  status: QuoteStatus;
+  pdfUrl: string | null;
+  // Internal diagnostics only — never rendered on the public status page.
+  failureReason: string | null;
+  createdAt: string;
+  updatedAt: string;
+};
+
+export type NewQuoteRequest = Pick<
+  QuoteRequest,
+  "workspaceId" | "company" | "email" | "description" | "budget"
+>;
+
+export type QuoteTransition = Pick<QuoteRequest, "status"> &
+  Partial<Pick<QuoteRequest, "pdfUrl" | "failureReason">>;

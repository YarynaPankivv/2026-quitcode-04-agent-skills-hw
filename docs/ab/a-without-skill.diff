+import type { Metadata } from "next";
+import Link from "next/link";
+import { notFound } from "next/navigation";
+import { QuoteAutoRefresh } from "@/components/quote-auto-refresh";
+import { getQuoteStatus } from "@/lib/data";
+import { QUOTE_BUDGET_LABELS } from "@/lib/quote-form";
+import { isQuoteId } from "@/lib/quote-workflow";
+
+// The address itself is the key to this page: keep it out of search engines and
+// out of the Referer header sent to the PDF host.
+export const metadata: Metadata = {
+  title: "Статус кошторису · Studio Nova",
+  robots: { index: false, follow: false },
+  referrer: "no-referrer",
+};
+
+const dateTimeFormat = new Intl.DateTimeFormat("uk-UA", { dateStyle: "medium", timeStyle: "short" });
+
+export default async function QuotePage({ params }: PageProps<"/quotes/[id]">) {
+  const { id } = await params;
+  if (!isQuoteId(id)) notFound();
+
+  // Rendered per request (connection() inside), never from a cache.
+  const status = await getQuoteStatus(id);
+  if (!status) notFound();
+  const { quote, view } = status;
+
+  return (
+    <div className="flex flex-1 flex-col">
+      <header className="border-b border-slate-200 bg-white">
+        <div className="mx-auto flex max-w-5xl items-center justify-between px-6 py-4">
+          <Link href="/" className="text-lg font-semibold tracking-tight">
+            Studio Nova
+          </Link>
+        </div>
+      </header>
+
+      <main className="mx-auto w-full max-w-xl flex-1 space-y-6 px-6 py-12">
+        <div className="space-y-1">
+          <h1 className="text-2xl font-semibold tracking-tight">Кошторис для {quote.company}</h1>
+          <p className="text-sm text-slate-500">
+            Запит від {dateTimeFormat.format(new Date(quote.createdAt))}
+            {quote.budget && ` · бюджет ${QUOTE_BUDGET_LABELS[quote.budget]}`}
+          </p>
+        </div>
+
+        <section
+          role="status"
+          aria-live="polite"
+          className="space-y-3 rounded-xl border border-slate-200 bg-white p-6 text-sm shadow-sm"
+        >
+          {view === "pending" && (
+            <>
+              <p className="flex items-center gap-2 text-base font-medium">
+                <span className="h-2.5 w-2.5 animate-pulse rounded-full bg-indigo-500" aria-hidden />
+                Готуємо кошторис…
+              </p>
+              <p className="text-slate-600">
+                Зазвичай це займає одну-дві хвилини. Сторінка оновиться сама, її можна не
+                перезавантажувати.
+              </p>
+              <QuoteAutoRefresh />
+            </>
+          )}
+
+          {view === "ready" && quote.pdfUrl && (
+            <>
+              <p className="text-base font-medium text-emerald-700">Кошторис готовий</p>
+              <a
+                href={quote.pdfUrl}
+                target="_blank"
+                rel="noopener noreferrer"
+                className="inline-block rounded-md bg-indigo-600 px-4 py-2 font-medium text-white hover:bg-indigo-700"
+              >
+                Відкрити PDF
+              </a>
+            </>
+          )}
+
+          {(view === "failed" || view === "expired") && (
+            <>
+              <p className="text-base font-medium text-red-700">Не вдалося підготувати кошторис</p>
+              <p className="text-slate-600">
+                Спробуйте надіслати запит ще раз. Якщо не вийде — залиште заявку на головній, і
+                менеджер порахує вручну.
+              </p>
+              <Link href="/quotes/new" className="inline-block font-medium text-indigo-700 hover:underline">
+                Надіслати запит ще раз
+              </Link>
+            </>
+          )}
+        </section>
+
+        <p className="text-xs text-slate-500">
+          Збережіть адресу цієї сторінки: за нею можна повернутися до статусу. Не пересилайте її
+          стороннім.
+        </p>
+      </main>
+    </div>
+  );
+}

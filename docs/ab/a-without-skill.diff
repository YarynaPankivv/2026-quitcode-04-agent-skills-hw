@@ -0,0 +1,63 @@
+import { db } from "@/lib/db";
+import { hasValidCallbackToken, parseQuoteCallback } from "@/lib/quote-workflow";
+
+// n8n `quote-request` calls this when a quote is done:
+//   POST /api/quotes/callback
+//   Authorization: Bearer <N8N_QUOTE_CALLBACK_SECRET>
+//   { "quoteId": "<uuid>", "status": "ready", "pdfUrl": "https://…" }
+//   { "quoteId": "<uuid>", "status": "failed", "error": "…" }
+
+const MAX_BODY_BYTES = 16 * 1024;
+const MIN_SECRET_LENGTH = 32;
+
+export async function POST(request: Request) {
+  // 1. Fail closed: without a (strong) secret nobody can update quotes.
+  const secret = process.env.N8N_QUOTE_CALLBACK_SECRET;
+  if (!secret || secret.length < MIN_SECRET_LENGTH) {
+    console.error("quote.callback_not_configured");
+    return Response.json({ error: "not_configured" }, { status: 503 });
+  }
+
+  // 2. Authenticate before reading the body.
+  if (!hasValidCallbackToken(request.headers.get("authorization"), secret)) {
+    return Response.json({ error: "unauthorized" }, { status: 401 });
+  }
+
+  // 3. Bounded JSON body.
+  if (!request.headers.get("content-type")?.toLowerCase().startsWith("application/json")) {
+    return Response.json({ error: "unsupported_media_type" }, { status: 415 });
+  }
+  if (Number(request.headers.get("content-length") ?? 0) > MAX_BODY_BYTES) {
+    return Response.json({ error: "payload_too_large" }, { status: 413 });
+  }
+  const raw = await request.text();
+  if (Buffer.byteLength(raw) > MAX_BODY_BYTES) {
+    return Response.json({ error: "payload_too_large" }, { status: 413 });
+  }
+
+  let body: unknown;
+  try {
+    body = JSON.parse(raw);
+  } catch {
+    return Response.json({ error: "invalid_json" }, { status: 400 });
+  }
+
+  // 4. Validate the shape and values (https-only PDF link, known statuses).
+  const parsed = parseQuoteCallback(body);
+  if (!parsed.ok) {
+    return Response.json({ error: "invalid_payload", field: parsed.field }, { status: 400 });
+  }
+  const { quoteId, change } = parsed.data;
+
+  // 5. First final result wins; a retried or late duplicate changes nothing.
+  //    It still gets 200 so n8n does not keep retrying it.
+  const outcome = await db.transitionQuote(quoteId, ["queued", "processing"], change);
+  if (outcome === "not_found") {
+    return Response.json({ error: "not_found" }, { status: 404 });
+  }
+
+  if (outcome === "updated") {
+    console.info("quote.completed", { quoteId, status: change.status });
+  }
+  return Response.json({ ok: true, updated: outcome === "updated" });
+}

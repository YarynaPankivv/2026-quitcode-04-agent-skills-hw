+"use server";
+
+import { after } from "next/server";
+import { headers } from "next/headers";
+import { redirect } from "next/navigation";
+import { db } from "@/lib/db";
+import { parseQuoteForm, type QuoteFormState } from "@/lib/quote-form";
+import { startQuoteWorkflow } from "@/lib/quote-workflow";
+import { takeRateLimit } from "@/lib/rate-limit";
+
+const PUBLIC_FORM_WORKSPACE_ID = "ws_studio_nova";
+
+// Every request costs a 40–90 s n8n run and a PDF render on the client's side.
+const QUOTE_RATE_LIMIT = { limit: 5, windowMs: 10 * 60 * 1000 };
+
+export async function requestQuote(
+  _prevState: QuoteFormState,
+  formData: FormData,
+): Promise<QuoteFormState> {
+  // 1. Server-side validation, always.
+  const parsed = parseQuoteForm(formData);
+  if (!parsed.ok) {
+    return { status: "invalid", errors: parsed.errors, values: parsed.values };
+  }
+
+  // 2. Public form: limit per address. x-forwarded-for is only trustworthy behind
+  //    a proxy that overwrites it.
+  const requestHeaders = await headers();
+  const ipAddress = requestHeaders.get("x-forwarded-for")?.split(",")[0].trim() || "127.0.0.1";
+  if (!takeRateLimit(`quote:${ipAddress}`, QUOTE_RATE_LIMIT.limit, QUOTE_RATE_LIMIT.windowMs)) {
+    return {
+      status: "error",
+      message: "Забагато запитів поспіль. Спробуйте ще раз за кілька хвилин.",
+      values: parsed.values,
+    };
+  }
+
+  // 3. Write.
+  let quoteId: string;
+  try {
+    const quote = await db.insertQuote({ ...parsed.data, workspaceId: PUBLIC_FORM_WORKSPACE_ID });
+    quoteId = quote.id;
+  } catch (error) {
+    const code = error instanceof Error ? error.name : "unknown";
+    console.error("quote.save_failed", { code });
+    return {
+      status: "error",
+      message: "Не вдалося зберегти запит. Спробуйте ще раз.",
+      values: parsed.values,
+    };
+  }
+
+  // 4. The workflow takes 40–90 s: never make the person wait for it here.
+  //    The trigger goes out after the response; n8n reports the result to
+  //    /api/quotes/callback and the status page picks it up.
+  after(() => startQuoteWorkflow(quoteId));
+
+  // 5. Only the id goes back to the browser, as the status page address.
+  redirect(`/quotes/${quoteId}`);
+}

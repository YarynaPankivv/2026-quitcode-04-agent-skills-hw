@@ -0,0 +1,86 @@
+import { QUOTE_BUDGETS, type QuoteBudget } from "./types";
+
+export const QUOTE_BUDGET_LABELS: Record<QuoteBudget, string> = {
+  "under-1000": "до $1 000",
+  "1000-3000": "$1 000–3 000",
+  "3000-10000": "$3 000–10 000",
+  "over-10000": "понад $10 000",
+};
+
+export const QUOTE_DESCRIPTION_MIN_LENGTH = 20;
+export const QUOTE_DESCRIPTION_MAX_LENGTH = 2000;
+
+export type QuoteFormField = "company" | "email" | "description" | "budget";
+
+export type QuoteFormData = {
+  company: string;
+  email: string;
+  description: string;
+  budget: QuoteBudget | null;
+};
+
+type QuoteFormValues = Partial<Record<QuoteFormField, string>>;
+
+export type QuoteFormState =
+  | { status: "idle" }
+  | {
+      status: "invalid";
+      errors: Partial<Record<QuoteFormField, string>>;
+      values: QuoteFormValues;
+    }
+  | { status: "error"; message: string; values: QuoteFormValues };
+
+export type ParseQuoteResult =
+  | { ok: true; data: QuoteFormData; values: QuoteFormValues }
+  | { ok: false; errors: Partial<Record<QuoteFormField, string>>; values: QuoteFormValues };
+
+const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
+
+function text(formData: FormData, name: QuoteFormField) {
+  const value = formData.get(name);
+  return typeof value === "string" ? value.trim() : "";
+}
+
+function isQuoteBudget(value: string): value is QuoteBudget {
+  return (QUOTE_BUDGETS as readonly string[]).includes(value);
+}
+
+export function parseQuoteForm(formData: FormData): ParseQuoteResult {
+  const company = text(formData, "company");
+  const email = text(formData, "email").toLowerCase();
+  const description = text(formData, "description");
+  const budget = text(formData, "budget");
+
+  // Echo back what the person typed (capped) so the form is not wiped on an error.
+  const values: QuoteFormValues = {
+    company: company.slice(0, 240),
+    email: email.slice(0, 400),
+    description: description.slice(0, QUOTE_DESCRIPTION_MAX_LENGTH * 2),
+    budget: isQuoteBudget(budget) ? budget : "",
+  };
+
+  const errors: Partial<Record<QuoteFormField, string>> = {};
+
+  if (!company) errors.company = "Вкажіть назву компанії";
+  else if (company.length > 120) errors.company = "Назва задовга: до 120 символів";
+
+  if (email.length > 200 || !EMAIL_RE.test(email)) errors.email = "Перевірте email";
+
+  if (description.length < QUOTE_DESCRIPTION_MIN_LENGTH) {
+    errors.description = "Опишіть задачу докладніше: що потрібно зробити і до якого терміну";
+  } else if (description.length > QUOTE_DESCRIPTION_MAX_LENGTH) {
+    errors.description = `Опис задовгий: ${description.length} із ${QUOTE_DESCRIPTION_MAX_LENGTH} символів`;
+  }
+
+  if (budget && !isQuoteBudget(budget)) errors.budget = "Оберіть бюджет зі списку";
+
+  if (Object.keys(errors).length > 0) {
+    return { ok: false, errors, values };
+  }
+
+  return {
+    ok: true,
+    data: { company, email, description, budget: isQuoteBudget(budget) ? budget : null },
+    values,
+  };
+}
diff --git a/lib/quote-workflow.ts b/lib/quote-workflow.ts
new file mode 100644
index 0000000..aaa7a8b
--- /dev/null
+++ b/lib/quote-workflow.ts
@@ -0,0 +1,149 @@
+import { createHash, timingSafeEqual } from "node:crypto";
+import { db } from "./db";
+import { QUOTE_BUDGET_LABELS } from "./quote-form";
+import type { QuoteRequest, QuoteTransition } from "./types";
+
+// The n8n `quote-request` workflow runs 40–90 s. Its Webhook node must answer
+// right away ("Respond: Immediately"); the result arrives later at
+// POST /api/quotes/callback. A trigger that takes longer than this is abandoned.
+const TRIGGER_TIMEOUT_MS = 10_000;
+
+// No callback this long after the request means the run is lost: the status
+// page stops waiting. A late callback is still accepted.
+export const QUOTE_DEADLINE_MS = 5 * 60 * 1000;
+
+const UUID_RE = /^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/;
+
+export function isQuoteId(value: unknown): value is string {
+  return typeof value === "string" && UUID_RE.test(value);
+}
+
+export type QuoteView = "pending" | "ready" | "failed" | "expired";
+
+export function quoteView(quote: QuoteRequest, now: number): QuoteView {
+  if (quote.status === "ready" || quote.status === "failed") return quote.status;
+  return now - Date.parse(quote.createdAt) > QUOTE_DEADLINE_MS ? "expired" : "pending";
+}
+
+async function failTrigger(quoteId: string, reason: string) {
+  await db.transitionQuote(quoteId, ["queued"], { status: "failed", failureReason: reason });
+}
+
+// Runs inside after(): never throws, records the outcome on the quote.
+export async function startQuoteWorkflow(quoteId: string) {
+  try {
+    const quote = await db.getQuote(quoteId);
+    if (!quote) return;
+
+    const url = process.env.N8N_QUOTE_WEBHOOK_URL;
+    if (!url) {
+      console.error("quote.trigger_not_configured", { quoteId });
+      await failTrigger(quoteId, "trigger_not_configured");
+      return;
+    }
+
+    const headers: Record<string, string> = { "content-type": "application/json" };
+    const token = process.env.N8N_QUOTE_WEBHOOK_TOKEN;
+    if (token) headers.authorization = `Bearer ${token}`;
+
+    // Only what the workflow needs for the quote. The callback address is fixed
+    // in n8n, not sent here: it receives our secret and must not be steerable.
+    const payload = {
+      quoteId: quote.id,
+      company: quote.company,
+      email: quote.email,
+      description: quote.description,
+      budget: quote.budget,
+      budgetLabel: quote.budget ? QUOTE_BUDGET_LABELS[quote.budget] : null,
+      requestedAt: quote.createdAt,
+    };
+
+    const response = await fetch(url, {
+      method: "POST",
+      headers,
+      body: JSON.stringify(payload),
+      // A redirect would resend the token and personal data somewhere else.
+      redirect: "error",
+      signal: AbortSignal.timeout(TRIGGER_TIMEOUT_MS),
+    });
+    await response.body?.cancel();
+
+    if (!response.ok) {
+      console.error("quote.trigger_rejected", { quoteId, status: response.status });
+      await failTrigger(quoteId, `trigger_http_${response.status}`);
+      return;
+    }
+
+    await db.transitionQuote(quoteId, ["queued"], { status: "processing" });
+  } catch (error) {
+    const code = error instanceof Error ? error.name : "unknown";
+    if (code === "TimeoutError") {
+      // Unknown outcome: n8n may still be running. Stay "queued" — the callback
+      // can still complete the quote, and the status page gives up at the deadline.
+      console.warn("quote.trigger_timeout", { quoteId });
+      return;
+    }
+    console.error("quote.trigger_failed", { quoteId, code });
+    try {
+      await failTrigger(quoteId, "trigger_unreachable");
+    } catch {
+      // Nothing more to do: the status page gives up at the deadline.
+    }
+  }
+}
+
+// --- Callback from n8n ------------------------------------------------------
+
+function sha256(value: string) {
+  return createHash("sha256").update(value).digest();
+}
+
+// Constant-time comparison: hashing first gives both sides the same length.
+export function hasValidCallbackToken(authorization: string | null, secret: string) {
+  return timingSafeEqual(sha256(authorization ?? ""), sha256(`Bearer ${secret}`));
+}
+
+export type QuoteCallback = { quoteId: string; change: QuoteTransition };
+
+export type ParseCallbackResult =
+  | { ok: true; data: QuoteCallback }
+  | { ok: false; field: "body" | "quoteId" | "status" | "pdfUrl" };
+
+function parsePdfUrl(value: unknown) {
+  if (typeof value !== "string" || value.length > 2048) return null;
+  let url: URL;
+  try {
+    url = new URL(value);
+  } catch {
+    return null;
+  }
+  // Rendered as a link on our page: https only, no embedded credentials.
+  if (url.protocol !== "https:" || url.username || url.password) return null;
+  return url.toString();
+}
+
+export function parseQuoteCallback(body: unknown): ParseCallbackResult {
+  if (typeof body !== "object" || body === null || Array.isArray(body)) {
+    return { ok: false, field: "body" };
+  }
+  const { quoteId, status, pdfUrl, error } = body as Record<string, unknown>;
+
+  if (!isQuoteId(quoteId)) return { ok: false, field: "quoteId" };
+
+  if (status === "ready") {
+    const url = parsePdfUrl(pdfUrl);
+    if (!url) return { ok: false, field: "pdfUrl" };
+    return { ok: true, data: { quoteId, change: { status: "ready", pdfUrl: url } } };
+  }
+
+  if (status === "failed") {
+    // Kept for diagnostics only; the customer sees a generic message.
+    const reason =
+      typeof error === "string" && error.trim()
+        ? error.replace(/[\u0000-\u001f\u007f]+/g, " ").trim().slice(0, 200)
+        : "workflow_failed";
+    return { ok: true, data: { quoteId, change: { status: "failed", failureReason: reason } } };
+  }
+
+  return { ok: false, field: "status" };
+}

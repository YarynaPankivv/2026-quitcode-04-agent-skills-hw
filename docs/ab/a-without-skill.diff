index 0000000..8608181
--- /dev/null
+++ b/components/quote-auto-refresh.tsx
@@ -0,0 +1,25 @@
+"use client";
+
+import { useEffect } from "react";
+import { useRouter } from "next/navigation";
+
+// Re-renders the server page on an interval. The page renders this only while the
+// quote is pending, so polling stops by itself once the result is in.
+export function QuoteAutoRefresh({ intervalMs = 5000 }: { intervalMs?: number }) {
+  const router = useRouter();
+
+  useEffect(() => {
+    // Background tabs do not poll; coming back refreshes at once.
+    const refreshIfVisible = () => {
+      if (document.visibilityState === "visible") router.refresh();
+    };
+    const timer = setInterval(refreshIfVisible, intervalMs);
+    document.addEventListener("visibilitychange", refreshIfVisible);
+    return () => {
+      clearInterval(timer);
+      document.removeEventListener("visibilitychange", refreshIfVisible);
+    };
+  }, [router, intervalMs]);
+
+  return null;
+}

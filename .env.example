# LeadDesk local settings. Copy this file to .env.local and adjust it there.
# .env* files are git-ignored (except this example), so real values never reach git.

# n8n contract (server-only: no NEXT_PUBLIC_ prefix). Real values live in .env.local only.
# Used by lib/n8n/client.ts (events lead-created, quote-request) and the callback route
# app/api/n8n/[event]. Locally the base URL points at the offline n8n mock: node tools/mock-n8n.mjs
# Production URLs only (/webhook): n8n's test URLs work just 120 s after "Listen for test event".
N8N_WEBHOOK_BASE_URL=http://127.0.0.1:5678/webhook
N8N_WEBHOOK_TOKEN=change-me-webhook-token
N8N_CALLBACK_SECRET=change-me-callback-secret
APP_BASE_URL=http://127.0.0.1:3000
